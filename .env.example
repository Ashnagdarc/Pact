# Core application configuration (Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
PACT_CONVEX_JWT_PRIVATE_JWK=

# Use the same value in the Next.js and Convex environments for server-to-server calls.
PACT_SERVER_SECRET=

# Optional: public push key used by the browser. Configure the matching private
# key and subject in the Convex environment (not in this file for the browser).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional: email delivery and beta waitlist integration
BREVO_API_KEY=
BREVO_BETA_WAITLIST_LIST_ID=
EMAIL_FROM=

# Optional: Cloudflare R2 evidence uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
